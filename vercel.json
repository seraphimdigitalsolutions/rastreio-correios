{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/tracking/:match*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/:code([A-Za-z]{2}[0-9]{9}[A-Za-z]{2})",
      "destination": "/index.html"
    },
    {
      "source": "/rastreio/:code*",
      "destination": "/index.html"
    }
  ]
}

